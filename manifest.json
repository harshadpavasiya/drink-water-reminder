{
  "manifest_version": 3,
  "name": "Drink Water Reminder",
  "version": "1.2",
  "description": "Reminds you to drink water at a customizable interval.",
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "109"
}
